{
  "name": "tehillim",
  "compatibility_date": "2026-08-04",
  "main": "worker/index.ts",
  "assets": {
    "directory": "dist",
    "binding": "ASSETS",
    // Every route below the toolbar is client-side, so a direct load falls back to the shell.
    "not_found_handling": "single-page-application",
    // Only detail payloads need the Worker; every other asset is served without invoking it.
    "run_worker_first": ["/data/detail_*"],
  },
  "r2_buckets": [{ "binding": "DETAIL", "bucket_name": "tehillim" }],
}
